# Export this variable before starting Uvicorn. .env is not loaded automatically.
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret

# PostgreSQL connection settings. Export before starting the application.
PGHOST=localhost
PGPORT=5432
PGDATABASE=refundops
PGUSER=postgres
# Keep the actual password private. The check command can prompt for it instead.
PGPASSWORD=replace-with-your-postgresql-password

# Both variables enable reporting. Use a dedicated demo spreadsheet.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# Slack app → Basic Information → App Credentials → Signing Secret.
SLACK_SIGNING_SECRET=replace-with-your-slack-signing-secret
